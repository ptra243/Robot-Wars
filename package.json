{
  "name": "robotwars",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run generate:card-descriptions && vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:card-descriptions": "tsx scripts/generateCardDescriptions.ts",
    "migrate:legacy-effects": "tsx scripts/migrateLegacyCardEffects.ts",
    "build:opponent-piles": "tsx scripts/opponentPiles.mts",
    "sim:draft-damage": "vitest run src/test/draftCountDamageSim.test.ts --reporter=verbose",
    "sim:band-ordering": "vitest run src/test/bandOrderingSim.test.ts --reporter=verbose"
  },
  "dependencies": {
    "phaser": "^4.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@rolldown/binding-win32-x64-msvc": "^1.0.0-rc.16",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~6.0.2",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.4"
  }
}
